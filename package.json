{
  "name": "obsidian-pandoc-reference-list",
  "version": "2.1.0",
  "description": "Displays formatted references for Pandoc citekeys in Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "check-types": "tsc --noEmit --skipLibCheck",
    "lint": "eslint ./src",
    "test": "jest --runInBand",
    "rlnotes": "git log $(git describe --tags --abbrev=0)..HEAD --oneline > release-notes.md && git add release-notes.md",
    "bump": "node version-bump.mjs && git add package.json manifest.json versions.json && npm run rlnotes",
    "release": "git commit -m $npm_package_version && git tag $npm_package_version && git push && git push --tags"
  },
  "keywords": [
    "obsidian",
    "pandoc",
    "citations"
  ],
  "author": "Christian Auguste",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@codemirror/buildhelper": "^1.0.2",
    "@codemirror/language": "https://github.com/lishid/cm-language.git",
    "@types/download": "^8.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.17",
    "@types/react-dom": "^18.3.7",
    "@types/which": "^2.0.2",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.25.5",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "xml-js": "^1.6.11"
  },
  "dependencies": {
    "citeproc": "2.4.63",
    "download": "^8.0.0",
    "execa": "^6.1.0",
    "fast-deep-equal": "^3.1.3",
    "fuse.js": "^6.6.2",
    "lru-cache": "^7.18.3",
    "preact": "^10.26.4",
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat",
    "react-select": "^5.10.1",
    "shell-path": "^3.0.0",
    "text-clipper": "^2.2.0",
    "which": "^5.0.0"
  },
  "jest": {
    "transformIgnorePatterns": [],
    "testEnvironment": "jsdom"
  },
  "allowScripts": {
    "github:lishid/cm-language#b817e72a9861b3f8a50a92a2ea53cbafc4f88eb3": true
  }
}
